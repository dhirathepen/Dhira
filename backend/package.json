{
  "name": "dhira",
  "version": "2.0.0",
  "private": true,
  "description": "Dhira — personal author platform (Express, local SQLite or Supabase Postgres)",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "migrate:status": "knex --knexfile knexfile.js migrate:list",
    "admin:create": "node scripts/createAdmin.js",
    "db:backup": "node scripts/backup.js",
    "test": "node run-tests.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
