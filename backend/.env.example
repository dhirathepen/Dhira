
DATABASE_FILE=data/dhira.sqlite

# ── Supabase / Postgres (production) ───────────────────────────────────────
# Leave DATABASE_URL unset to keep using the local SQLite file above.
# Supabase: Project Settings → Database → Connection string → Transaction pooler.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Supabase requires TLS; set DATABASE_SSL=false only for a local Postgres server.
# DATABASE_SSL=true

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Applied migrations automatically on every boot (recommended).
RUN_MIGRATIONS=true

# ── Cookies / sessions ─────────────────────────────────────────────────────
# Secure cookies require HTTPS. Keep true in production.
COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# Number of trusted proxy hops in front of the app (Render/Railway: 1).
TRUST_PROXY=1

# ── CORS (only needed when the frontend is hosted on a different domain) ──
# Comma-separated, no trailing slash. Leave empty when this app serves the site.
ALLOWED_ORIGINS=

# Stable salt for rate-limit fingerprints. Generate any long random string.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# ── First-run admin (optional, for hosts without a shell) ──────────────────
# If no admin exists yet, these values create one at boot.
# Remove both variables immediately after the first successful boot.
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

# ── Uploads ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=8
