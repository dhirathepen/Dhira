{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix backend --no-audit --no-fund",
  "buildCommand": "echo 'No build step needed'",
  "functions": {
    "api/index.js": {
      "includeFiles": "frontend/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
